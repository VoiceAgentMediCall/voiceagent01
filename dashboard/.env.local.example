# dashboard/.env.local.example — copy to .env.local and fill in a real value.
# Shared Supabase/LiveKit credentials live in the repo-root .env.example instead —
# copy that one too (to repo-root .env), it's loaded automatically via dotenv-cli
# (see package.json's dev/build/start scripts).
# Never commit .env.local itself.

# --- Supabase publishable key (dashboard-only — eval-runner never needs this) ---
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Login page feature flag ---
# Set to "true" only once Google OAuth is actually configured in Supabase Auth
# (Google Cloud Console client ID/secret pasted into Supabase → Auth → Providers).
# Leave unset/false to hide the Google button and avoid a broken sign-in flow.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
