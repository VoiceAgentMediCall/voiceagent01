# .env.example (repo root) — copy to .env and fill in real values.
# See .env's own header comment for what belongs here vs. in a per-service file.

# --- Supabase project (same project used by dashboard + eval-runner) ---
SUPABASE_URL=https://your-ref.supabase.co
# Same value as SUPABASE_URL above — Next.js needs the NEXT_PUBLIC_ prefix
# to expose it client-side. Keep both in sync.
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- LiveKit Cloud (same project used by livekit/agent.py + dashboard) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Groq (same key used by eval-runner + evals/goldenset.yaml via --env-path) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
