# eval-runner/.env.example — copy to .env and fill in a real value.
# Shared Supabase/Groq credentials live in the repo-root .env.example instead —
# copy that one too (to repo-root .env). This service doesn't load any .env
# file itself — for local (non-Docker) runs, source both files:
#   set -a && source ../.env && source .env && set +a && node dist/index.js
# Docker Compose loads both automatically via the env_file: list.

# Use the Session Pooler string (port 5432 via aws-0-<region>.pooler.supabase.com), NOT the
# "Direct connection" string from Supabase's dashboard — the direct host is IPv6-only on many
# networks and this service's LISTEN/NOTIFY worker will fail to connect. Session mode (not the
# 6543 transaction pooler) still supports LISTEN/NOTIFY.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<pwd>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Service ---
# 3001, not 3000 — the dashboard's Next.js dev server also defaults to 3000, and both
# services need to run at once locally.
PORT=3001
# Optional: override the goldenset path (defaults to ../evals/goldenset.yaml relative to dist/).
# IMPORTANT: leave this line commented out, don't set it to an empty string — the
# code does `process.env.GOLDENSET_PATH ?? <default>`, and `??` only falls back on
# null/undefined, NOT on an empty string. An empty value here silently breaks
# goldenset resolution instead of falling back to the default.
# GOLDENSET_PATH=
